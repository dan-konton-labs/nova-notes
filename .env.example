# Nova Notes (Rust) settings. Copy to .env and fill in. Names match the
# Python build, so an existing Open Notebook .env keeps working.
# Secrets can also come from files: set NAME_FILE=/path instead of NAME.

# Server
API_HOST=127.0.0.1
API_PORT=5055
DATA_FOLDER=./data
# CORS_ORIGINS=https://notes.example.ts.net
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# Login (leave unset only on a private machine)
# OPEN_NOTEBOOK_PASSWORD=

# Encrypts stored AI provider keys. Any long random string; keep it safe.
# OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Database: an embedded one under DATA_FOLDER unless one of these is set
# SURREAL_URL=ws://localhost:8000/rpc
# SURREAL_ADDRESS=localhost
# SURREAL_PORT=8000
# SURREAL_USER=root
# SURREAL_PASSWORD=
# SURREAL_NAMESPACE=open_notebook
# SURREAL_DATABASE=open_notebook

# Background jobs and AI calls
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=5
# ESPERANTO_LLM_TIMEOUT=180

# Discover: a self-hosted SearXNG searched first (JSON format must be on).
# Without it Discover uses public engines, which often block automated searches.
# The host running Nova Notes must resolve this name (MagicDNS on).
# SEARXNG_URL=https://searxng.example.ts.net
