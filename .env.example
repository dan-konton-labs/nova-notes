# Nova Notes (Rust) settings. Copy to .env and fill in. Names match the
# Python build, so an existing Open Notebook .env keeps working.
# Secrets can also come from files: set NAME_FILE=/path instead of NAME.

# Server
API_HOST=127.0.0.1
API_PORT=5055
DATA_FOLDER=./data
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# Host names this server answers to, besides localhost, 127.0.0.1 and [::1].
# Requests for any other name are refused (this stops DNS-rebinding attacks).
# Add the name you open the app by: a Tailscale MagicDNS name, a LAN name.
# Comma-separated; a leading dot allows every name under it; * turns the
# check off. The host of OPEN_NOTEBOOK_PUBLIC_URL / API_URL is added for you.
# OPEN_NOTEBOOK_ALLOWED_HOSTS=notes.tailnet-name.ts.net
# OPEN_NOTEBOOK_ALLOWED_HOSTS=.tailnet-name.ts.net

# Other websites allowed to call the API from a browser. Default: none.
# `*` is honoured only when OPEN_NOTEBOOK_PASSWORD is set (and never with
# cookies); cross-site writes then still need the password as a Bearer header.
# CORS_ORIGINS=https://app.example.com

# Login. Without a password the server only starts on a loopback API_HOST
# (127.0.0.1, ::1, localhost). The Docker image listens on 0.0.0.0, so set
# a password there, or OPEN_NOTEBOOK_ALLOW_UNAUTHENTICATED=true if a firewall
# or Tailscale ACLs already limit who can connect.
# OPEN_NOTEBOOK_PASSWORD=
# OPEN_NOTEBOOK_ALLOW_UNAUTHENTICATED=false
# Each sign-in to the web UI gets its own session, kept by the server for 30
# days from sign-in (signing out or changing the password and restarting ends
# it). After 5 wrong passwords from one address (web form or API Bearer) that
# address waits 2 s, 4 s, 8 s ... up to 15 minutes per further failure; more
# than 100 failures a minute from everywhere pauses all password checks for
# the rest of that minute.

# Behind a reverse proxy (Tailscale Serve, Caddy, nginx):
# Set OPEN_NOTEBOOK_PUBLIC_URL to the exact public HTTPS origin (including any
# non-default port). Preserve the public Host where possible. If the proxy
# rewrites it, the backend Host must also be allowed.
# Trust forwarded headers only when clients cannot reach Nova Notes directly,
# and the proxy sets X-Forwarded-Proto/Host and puts the actual client IP last
# in X-Forwarded-For. The public URL sets the canonical origin but does not
# recover the client IP. Without header trust, proxied sign-ins and Bearer
# requests share the proxy's address for throttling.
# OPEN_NOTEBOOK_TRUST_PROXY_HEADERS=false

# Encrypts stored AI provider keys. Any long random string; keep it safe.
# OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Database: an embedded one under DATA_FOLDER unless one of these is set
# SURREAL_URL=ws://localhost:8000/rpc
# SURREAL_ADDRESS=localhost
# SURREAL_PORT=8000
# SURREAL_USER=root
# Required with SURREAL_URL: without it the server signs in with "root" and warns at startup.
# SURREAL_PASSWORD=
# SURREAL_NAMESPACE=open_notebook
# SURREAL_DATABASE=open_notebook

# Background jobs and AI calls
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=5
# Jobs queued or running at once; past this, new jobs get a 429 until some finish.
# OPEN_NOTEBOOK_MAX_PENDING_JOBS=10000
# Finished jobs (completed/failed/canceled) older than this many days are deleted,
# except those a source, episode or meeting still links to. 0 keeps them forever.
# OPEN_NOTEBOOK_JOB_RETENTION_DAYS=30
# Longest content (characters) a podcast is generated from, given or taken from a notebook.
# OPEN_NOTEBOOK_MAX_PODCAST_CONTENT_CHARS=2000000
# Longest pasted text (characters) a text source may have; longer ones get a 400.
# OPEN_NOTEBOOK_MAX_TEXT_SOURCE_CHARS=10000000
# ESPERANTO_LLM_TIMEOUT=180

# Where stored AI credentials may send their keys.
# public_only also refuses loopback and private addresses for provider URLs
# (breaks a local Ollama / LM Studio); the default, self_hosted, refuses only
# link-local and cloud-metadata addresses.
# OPEN_NOTEBOOK_PROVIDER_URL_POLICY=self_hosted
# A first-party provider's base URL (OpenAI, Anthropic, Groq, ...) must be an
# https URL on that provider's own domain. Set true to allow any host, e.g. to
# route a first-party key through your own gateway.
# OPEN_NOTEBOOK_ALLOW_CUSTOM_PROVIDER_BASE_URLS=false
# Vertex AI service-account files must live here (default DATA_FOLDER/vertex);
# the file named by GOOGLE_APPLICATION_CREDENTIALS is also allowed.
# OPEN_NOTEBOOK_VERTEX_CREDENTIALS_DIR=./data/vertex

# Where link sources and Discover results may be fetched from. The default,
# public_only, refuses loopback, private (10.x, 192.168.x, ...), tailnet
# (100.64.0.0/10) and other internal addresses, on every redirect hop. Set
# self_hosted to ingest pages from services on your LAN or tailnet; even then
# a public page may not redirect into them. Link-local and cloud-metadata
# addresses are refused under both.
# OPEN_NOTEBOOK_SOURCE_URL_POLICY=public_only

# Discover: a self-hosted SearXNG searched first (JSON format must be on).
# Without it Discover uses public engines, which often block automated searches.
# The host running Nova Notes must resolve this name (MagicDNS on).
# SEARXNG_URL=https://searxng.example.ts.net

# Container only: keep running as root instead of dropping to uid 10001 (not recommended).
# NOVA_RUN_AS_ROOT=false
